{
  "cleanUrls": false,
  "headers": [
    {
      "source": "offline.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "delete-account",
      "destination": "/delete-account.html"
    },
    {
      "source": "delete-account/",
      "destination": "/delete-account.html"
    }
  ]
}
