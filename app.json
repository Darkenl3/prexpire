{
  "expo": {
    "name": "Prexpire",
    "slug": "prexpire",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#030709",
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "bundleIdentifier": "com.ttommy0388.prexpire",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ttommy0388.prexpire"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Prexpire uses your camera to read expiry dates on packaging. Images are processed on your device and never uploaded.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "splash": {
            "backgroundColor": "#F8FCFB",
            "dark": { "backgroundColor": "#030709" }
          }
        }
      ],
      "./plugins/withMlKitOcrModel"
    ]
  }
}
